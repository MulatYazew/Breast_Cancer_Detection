# Copy to .env and fill in locally. Do not commit the filled file.

# Required before the research API will accept a physician approval.
REVIEWER_TOKEN=replace-with-a-local-secret

# Only needed to download a gated model. MedGemma is not loaded by default.
HF_TOKEN=

# reporting.llm.model_id in config.yaml selects the generator.
# google/medgemma-27b-text-it is refused on machines with under 48 GiB RAM.
# google/medgemma-1.5-4b-it requires HF_TOKEN and accepted Hugging Face terms.
# Qwen/Qwen2.5-3B-Instruct is the existing configured local model and is not MedGemma.
